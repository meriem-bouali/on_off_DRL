<routes>

        <vType id="ego_veh_vtype"  color="magenta" vClass="passenger" length="5.0" carFollowModel="IDM" tau="1.6" accel="0.73" decel="1.67" />
        <vTypeDistribution id="HDV" >
                <vType id="aggressive" probability="0.2" color="#00FFFF" vClass="passenger" length="5.0" carFollowModel="IDM"   laneChangeModel="LC2013"  lcCooperative="-1" lcSpeedGain="3.0"   />
                <vType id="normal" probability="0.6" color="#FF4500" vClass="passenger" length="5.0" carFollowModel="IDM"    laneChangeModel="LC2013"  lcCooperative="1.0" lcSpeedGain="1.0"  />
                <vType id="conservative" probability="0.2" color="#32CD32" vClass="passenger" length="5.0" carFollowModel="IDM"   laneChangeModel="LC2013"  lcCooperative="0" lcSpeedGain="0"  />
        </vTypeDistribution>
        

        <route id="ego_veh_route" edges="0to1 1to2 2to3 3to4 4to5 5to6 6to7" />
        
        <!-- Distribution 1: Main highway entry to various exits -->
        <routeDistribution id="main">
        <route id="main_to_main"     edges="0to1 1to2 2to3 3to4 4to5 5to6 6to7" probability="0.70"/>
        <route id="main_to_offramp1"    edges="0to1 1to2 2to9" probability="0.10"/>
        <route id="main_to_offramp2"    edges="0to1 1to2 2to3 3to4 4to11" probability="0.10"/>
        <route id="main_to_offramp3"    edges="0to1 1to2 2to3 3to4 4to5 5to6 6to13" probability="0.10"/>
        </routeDistribution>

        <!-- Distribution 2: Ramp 1 on-ramp to various exits -->
        <routeDistribution id="on_ramp_1">
        <route id="onramp1_to_main"     edges="8to1 1to2 2to3 3to4 4to5 5to6 6to7" probability="0.55"/>
        <route id="onramp1_to_offramp1"    edges="8to1 1to2 2to9" probability="0.15"/>
        <route id="onramp1_to_offramp2"    edges="8to1 1to2 2to3 3to4 4to11" probability="0.15"/>
        <route id="onramp1_to_offramp3"    edges="8to1 1to2 2to3 3to4 4to5 5to6 6to13" probability="0.15"/>
        </routeDistribution>

        <!-- Distribution 3: Ramp 2 on-ramp to various exits -->
        <routeDistribution id="on_ramp_2">
        <route id="onramp2_to_main"     edges="10to3 3to4 4to5 5to6 6to7" probability="0.60"/>
        <route id="onramp2_to_offramp2"    edges="10to3 3to4 4to11" probability="0.20"/>
        <route id="onramp2_to_offramp3"    edges="10to3 3to4 4to5 5to6 6to13" probability="0.20"/>
        </routeDistribution>

        <!-- Distribution 4: Ramp 3 on-ramp to various exits -->
        <!-- <routeDistribution id="on_ramp_3">
        <route id="onramp3_to_main"     edges="12to5 5to6 6to7" probability="0.70"/>
        <route id="onramp3_to_offramp3"  edges="12to5 5to6 6to13" probability="0.30"/>
        </routeDistribution> -->
                

        <flow id="flow_mainstream" type="HDV" begin="0" end="3600" vehsPerHour="4000" route="main"  departLane="free" arrivalLane="random"  departSpeed="max" />  <!-- LOS C -->
        <flow id="flow_on_ramp1" type="HDV" begin="0" end="3600" vehsPerHour="300" route="on_ramp_1"  departSpeed="max" />  <!-- LOS B -->
        <flow id="flow_on_ramp2" type="HDV" begin="0" end="3600" vehsPerHour="900" route="on_ramp_2"  departSpeed="max" />  <!-- LOS B -->
       <!-- <flow id="flow_on_ramp3" type="HDV" begin="0" end="3600" vehsPerHour="300" route="on_ramp_3"  departSpeed="max" />   LOS A -->
        
            
</routes>
