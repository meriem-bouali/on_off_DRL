<viewsettings>
    <scheme  name="default">
        <vehicles
            
            vehicleQuality="2" 
            showBlinker="0">
        </vehicles>   

        <edges  
          laneShowBorders="1"
          laneName_show="0"
        />  

         
    </scheme>

